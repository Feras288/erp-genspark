# =====================================================
# ERP Backend — environment example
# Copy to backend/.env (gitignored) and fill real values.
# =====================================================

NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://erp_user:erp_dev_password_change_me@localhost:5432/erp_dev?schema=public

# JWT
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_at_least_32_chars_access
JWT_REFRESH_SECRET=replace_me_with_a_long_random_string_at_least_32_chars_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS — must match the frontend URL
CORS_ORIGIN=http://localhost:3000
