// =====================================================
// ERP System — Prisma schema
// Saudi-market ERP, single-client today, SaaS-ready.
// All commercial rows carry companyId for multi-tenancy later.
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// Core: company (the tenant-equivalent for the future)
// =====================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  vatNumber String?  @unique
  crNumber  String?  // Saudi Commercial Registration
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  currency  String   @default("SAR")
  vatRate   Decimal  @default(15.00) @db.Decimal(5, 2) // Saudi VAT default
  fiscalYearStartMonth Int @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  roles Role[]
  products Product[]
  partners Partner[]

  @@index([name])
  @@map("companies")
}

// =====================================================
// RBAC: users, roles, permissions
// Every user belongs to ONE company today.
// Phase 1: login, JWT, refresh tokens, audit log.
// =====================================================

model User {
  id           String   @id @default(cuid())
  companyId    String
  email        String
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // SaaS-ready paranoid fields
  deletedAt DateTime?

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  refreshTokens RefreshToken[]

  productsCreated Product[] @relation("ProductCreatedBy")
  productsUpdated Product[] @relation("ProductUpdatedBy")
  partnersCreated Partner[] @relation("PartnerCreatedBy")
  partnersUpdated Partner[] @relation("PartnerUpdatedBy")

  @@unique([companyId, email])           // no duplicate emails inside one company
  @@index([email])
  @@index([companyId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  companyId   String?  // null => global / system role
  name        String   // e.g. "Company Admin", "Accountant"
  key         String   // machine key e.g. "company_admin"
  description String?
  isSystem    Boolean  @default(false)   // built-in system role, cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company            Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles          UserRole[]
  rolePermissions    RolePermission[]

  @@unique([companyId, key])
  @@index([companyId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "users.read", "sales.invoice.create"
  module      String   // e.g. "users", "sales"
  action      String   // e.g. "read", "create", "update", "delete"
  description String?

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// Refresh tokens for JWT rotation. Hashed at rest.
model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Append-only audit trail of sensitive operations.
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  action     String   // e.g. "auth.login", "user.create", "invoice.issue"
  entity     String?  // e.g. "User", "SalesInvoice"
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// =====================================================
// Phase 2: master data — Products and Partners only.
// NO inventory, NO warehouses, NO stock movements, NO invoices.
// =====================================================

enum ProductType {
  PRODUCT
  SERVICE
}

model Product {
  id             String      @id @default(cuid())
  companyId      String
  sku            String
  name           String
  nameAr         String?
  description    String?
  type           ProductType @default(PRODUCT)
  barcode        String?
  unit           String?     // e.g. "pcs", "kg", "hr"
  priceBeforeVat Decimal?    @db.Decimal(18, 4)
  vatRate        Decimal     @default(15.00) @db.Decimal(5, 2)

  isActive  Boolean   @default(true)
  deletedAt DateTime? // soft delete only

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User?   @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?   @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Unique sku per company (sku is always non-null).
  @@unique([companyId, sku])
  // Unique barcode per company, but allow multiple nulls in Postgres.
  // Prisma cannot express nullable-unique directly; we use a partial unique
  // index via raw SQL in the migration (see phase2 migration).
  @@index([companyId, isActive])
  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@map("products")
}

enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model Partner {
  id       String      @id @default(cuid())
  companyId String
  code     String?
  name     String
  nameAr   String?
  type     PartnerType @default(CUSTOMER)

  // Saudi identity fields, all optional.
  vatNumber            String? // 15-digit VAT number
  commercialRegistration String? // CR number (سجل تجاري)

  email   String?
  phone   String?
  address String?
  city    String?
  country String? @default("SA")

  isActive  Boolean   @default(true)
  deletedAt DateTime? // soft delete only

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("PartnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("PartnerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // We use a partial unique index via raw SQL in the migration for `code`.
  @@index([companyId, isActive])
  @@index([companyId, deletedAt])
  @@index([companyId, type])
  @@index([companyId, name])
  @@map("partners")
}
