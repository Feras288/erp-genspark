// =====================================================
// ERP System — Prisma schema
// Saudi-market ERP, single-client today, SaaS-ready.
// All commercial rows carry companyId for multi-tenancy later.
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// Core: company (the tenant-equivalent for the future)
// =====================================================

model Company {
  id                   String   @id @default(cuid())
  name                 String
  vatNumber            String?  @unique
  crNumber             String? // Saudi Commercial Registration
  address              String?
  phone                String?
  email                String?
  logoUrl              String?
  currency             String   @default("SAR")
  vatRate              Decimal  @default(15.00) @db.Decimal(5, 2) // Saudi VAT default
  fiscalYearStartMonth Int      @default(1)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users                User[]
  roles                Role[]
  products             Product[]
  partners             Partner[]
  warehouses           Warehouse[]
  stockLevels          StockLevel[]
  stockMovements       StockMovement[]
  salesInvoices        SalesInvoice[]
  salesInvoiceLines    SalesInvoiceLine[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  accounts             Account[]
  journalEntries       JournalEntry[]
  journalEntryLines    JournalEntryLine[]
  payments             Payment[]

  @@index([name])
  @@map("companies")
}

// =====================================================
// RBAC: users, roles, permissions
// Every user belongs to ONE company today.
// Phase 1: login, JWT, refresh tokens, audit log.
// =====================================================

model User {
  id           String    @id @default(cuid())
  companyId    String
  email        String
  passwordHash String
  fullName     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // SaaS-ready paranoid fields
  deletedAt DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles     UserRole[]
  refreshTokens RefreshToken[]

  productsCreated           Product[]         @relation("ProductCreatedBy")
  productsUpdated           Product[]         @relation("ProductUpdatedBy")
  partnersCreated           Partner[]         @relation("PartnerCreatedBy")
  partnersUpdated           Partner[]         @relation("PartnerUpdatedBy")
  warehousesCreated         Warehouse[]       @relation("WarehouseCreatedBy")
  warehousesUpdated         Warehouse[]       @relation("WarehouseUpdatedBy")
  stockMovementsCreated     StockMovement[]   @relation("StockMovementCreatedBy")
  salesInvoicesCreated      SalesInvoice[]    @relation("SalesInvoiceCreatedBy")
  salesInvoicesUpdated      SalesInvoice[]    @relation("SalesInvoiceUpdatedBy")
  salesInvoicesIssued       SalesInvoice[]    @relation("SalesInvoiceIssuedBy")
  salesInvoicesCancelled    SalesInvoice[]    @relation("SalesInvoiceCancelledBy")
  purchaseInvoicesCreated   PurchaseInvoice[] @relation("PurchaseInvoiceCreatedBy")
  purchaseInvoicesUpdated   PurchaseInvoice[] @relation("PurchaseInvoiceUpdatedBy")
  purchaseInvoicesReceived  PurchaseInvoice[] @relation("PurchaseInvoiceReceivedBy")
  purchaseInvoicesCancelled PurchaseInvoice[] @relation("PurchaseInvoiceCancelledBy")
  accountsCreated           Account[]         @relation("AccountCreatedBy")
  accountsUpdated           Account[]         @relation("AccountUpdatedBy")
  journalEntriesCreated     JournalEntry[]    @relation("JournalEntryCreatedBy")
  journalEntriesUpdated     JournalEntry[]    @relation("JournalEntryUpdatedBy")
  journalEntriesPosted      JournalEntry[]    @relation("JournalEntryPostedBy")
  journalEntriesCancelled   JournalEntry[]    @relation("JournalEntryCancelledBy")
  paymentsCreated           Payment[]         @relation("PaymentCreatedBy")
  paymentsUpdated           Payment[]         @relation("PaymentUpdatedBy")
  paymentsCancelled         Payment[]         @relation("PaymentCancelledBy")

  @@unique([companyId, email]) // no duplicate emails inside one company
  @@index([email])
  @@index([companyId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  companyId   String? // null => global / system role
  name        String // e.g. "Company Admin", "Accountant"
  key         String // machine key e.g. "company_admin"
  description String?
  isSystem    Boolean  @default(false) // built-in system role, cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([companyId, key])
  @@index([companyId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "users.read", "sales.invoice.create"
  module      String // e.g. "users", "sales"
  action      String // e.g. "read", "create", "update", "delete"
  description String?

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// Refresh tokens for JWT rotation. Hashed at rest.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Append-only audit trail of sensitive operations.
model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  action    String // e.g. "auth.login", "user.create", "invoice.issue"
  entity    String? // e.g. "User", "SalesInvoice"
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// =====================================================
// Phase 2: master data — Products and Partners only.
// NO inventory, NO warehouses, NO stock movements, NO invoices.
// =====================================================

enum ProductType {
  PRODUCT
  SERVICE
}

model Product {
  id             String      @id @default(cuid())
  companyId      String
  sku            String
  name           String
  nameAr         String?
  description    String?
  type           ProductType @default(PRODUCT)
  barcode        String?
  unit           String? // e.g. "pcs", "kg", "hr"
  priceBeforeVat Decimal?    @db.Decimal(18, 4)
  vatRate        Decimal     @default(15.00) @db.Decimal(5, 2)

  isActive  Boolean   @default(true)
  deletedAt DateTime? // soft delete only

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  stockLevels          StockLevel[]
  stockMovements       StockMovement[]
  salesInvoiceLines    SalesInvoiceLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]

  // Unique sku per company (sku is always non-null).
  @@unique([companyId, sku])
  // Unique barcode per company, but allow multiple nulls in Postgres.
  // Prisma cannot express nullable-unique directly; we use a partial unique
  // index via raw SQL in the migration (see phase2 migration).
  @@index([companyId, isActive])
  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@map("products")
}

enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model Partner {
  id        String      @id @default(cuid())
  companyId String
  code      String?
  name      String
  nameAr    String?
  type      PartnerType @default(CUSTOMER)

  // Saudi identity fields, all optional.
  vatNumber              String? // 15-digit VAT number
  commercialRegistration String? // CR number (سجل تجاري)

  email   String?
  phone   String?
  address String?
  city    String?
  country String? @default("SA")

  isActive  Boolean   @default(true)
  deletedAt DateTime? // soft delete only

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  company                    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy                  User?             @relation("PartnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                  User?             @relation("PartnerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  salesInvoices              SalesInvoice[]
  purchaseInvoicesAsSupplier PurchaseInvoice[] @relation("PurchaseInvoiceSupplier")

  // We use a partial unique index via raw SQL in the migration for `code`.
  @@index([companyId, isActive])
  @@index([companyId, deletedAt])
  @@index([companyId, type])
  @@index([companyId, name])
  @@map("partners")
}

// =====================================================
// Phase 3: Inventory Core — Warehouses, StockLevels, StockMovements.
// NO sales, NO purchases, NO accounting, NO costing/COGS, NO ZATCA.
// =====================================================

enum StockMovementType {
  OPENING_BALANCE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  SALE_OUT
  PURCHASE_IN
}

enum StockMovementDirection {
  IN
  OUT
}

model Warehouse {
  id          String    @id @default(cuid())
  companyId   String
  code        String // unique per company
  name        String
  nameAr      String?
  address     String?
  city        String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime? // soft delete only
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("WarehouseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("WarehouseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  SalesInvoiceLine    SalesInvoiceLine[]
  PurchaseInvoiceLine PurchaseInvoiceLine[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@map("warehouses")
}

model StockLevel {
  id               String   @id @default(cuid())
  companyId        String
  productId        String
  warehouseId      String
  quantity         Decimal  @default(0) @db.Decimal(18, 4) // current on-hand
  reservedQuantity Decimal  @default(0) @db.Decimal(18, 4) // reserved / not yet decremented
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  // One StockLevel per (companyId, product, warehouse). No partial unique needed:
  // both productId and warehouseId are FK NOT NULL.
  @@unique([companyId, productId, warehouseId])
  @@index([companyId, productId])
  @@index([companyId, warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id            String                 @id @default(cuid())
  companyId     String
  productId     String
  warehouseId   String
  movementType  StockMovementType
  direction     StockMovementDirection
  quantity      Decimal                @db.Decimal(18, 4)
  referenceType String? // optional, e.g. "manual_adjustment" / "transfer"
  referenceId   String? // optional FK-as-string (no hard FK until later phases)
  reason        String? // required for adjustments
  notes         String?
  movementDate  DateTime               @default(now())
  createdAt     DateTime               @default(now())
  createdById   String? // via User relation (SetNull)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Append-only. No updatedAt. No soft delete on movements.
  @@index([companyId, movementDate])
  @@index([companyId, productId, movementDate])
  @@index([companyId, warehouseId, movementDate])
  @@index([companyId, movementType])
  @@map("stock_movements")
}

// =====================================================
// Phase 4: Sales + POS — schema only in Phase 4A.
// NO business logic, NO endpoints, NO tests, NO UI yet.
// NO accounting, NO purchases, NO reports, NO ZATCA.
// =====================================================

enum SalesInvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum SalesInvoiceType {
  STANDARD
  POS
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

// =====================================================
// Phase 10A: AR Payments + Settlement Tracking.
// Phase 10A-B-1: schema + enums skeleton only.
//   * NO settlement calculations (Phase 10A-B-2).
//   * NO PAID / PARTIALLY_PAID status enum (deferred — T-2 lock).
//   * NO AR-Aging source change (Phase 9 invariants preserved).
//   * NO AP payments (Phase 10B, separate domain).
//   * NO GL / bank reconciliation / drill-down statements.
// One of salesInvoiceId / purchaseInvoiceId is required (CHECK
// enforced in migration SQL) so 10B can drop in cleanly.
// =====================================================

enum PaymentInvoiceType {
  SALES
  PURCHASE
}

enum PaymentStatus {
  POSTED
  CANCELLED
}

model Payment {
  id                String             @id @default(cuid())
  companyId         String
  paymentMethod     PaymentMethod
  amount            Decimal            @db.Decimal(18, 4)
  paidAt            DateTime           @default(now())
  reference         String?
  notes             String?
  // Exactly one of these two FKs is populated. We do NOT FK
  // invoiceId on a polymorphic column because Prisma cannot
  // express polymorphic FK + CHECK in one declaration; the
  // migration SQL adds a CHECK constraint to enforce the
  // exactly-one invariant.
  salesInvoiceId    String?
  purchaseInvoiceId String?
  invoiceType       PaymentInvoiceType
  status            PaymentStatus      @default(POSTED)
  idempotencyKey    String? // optional client-supplied key (Phase 10A-B-2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdById       String?
  updatedById       String?
  cancelledAt       DateTime?
  cancelledById     String?
  deletedAt         DateTime? // soft delete (reversible)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesInvoice    SalesInvoice?    @relation("PaymentSalesInvoice", fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  purchaseInvoice PurchaseInvoice? @relation("PaymentPurchaseInvoice", fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?            @relation("PaymentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  cancelledBy     User?            @relation("PaymentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, paidAt])
  @@index([companyId, deletedAt])
  @@index([companyId, invoiceType])
  @@index([salesInvoiceId])
  @@index([purchaseInvoiceId])
  @@map("payments")
}

model SalesInvoice {
  id            String             @id @default(cuid())
  companyId     String
  invoiceNumber String
  status        SalesInvoiceStatus @default(DRAFT)
  type          SalesInvoiceType   @default(STANDARD)
  customerId    String?
  issueDate     DateTime?
  dueDate       DateTime?
  subtotal      Decimal            @default(0) @db.Decimal(18, 4)
  vatTotal      Decimal            @default(0) @db.Decimal(18, 4)
  discountTotal Decimal            @default(0) @db.Decimal(18, 4)
  total         Decimal            @default(0) @db.Decimal(18, 4)
  paymentMethod PaymentMethod?
  paidAmount    Decimal?           @db.Decimal(18, 4)
  notes         String?
  cancelledAt   DateTime?
  issuedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  createdById   String?
  updatedById   String?
  issuedById    String?
  cancelledById String?
  deletedAt     DateTime?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Partner? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy   User?    @relation("SalesInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?    @relation("SalesInvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  issuedBy    User?    @relation("SalesInvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  cancelledBy User?    @relation("SalesInvoiceCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  lines    SalesInvoiceLine[]
  payments Payment[]          @relation("PaymentSalesInvoice")

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, customerId])
  @@index([companyId, issueDate])
  @@index([companyId, deletedAt])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id             String   @id @default(cuid())
  companyId      String
  invoiceId      String
  productId      String
  warehouseId    String? // null for SERVICE lines; required for PRODUCT lines on issue
  description    String?
  quantity       Decimal  @db.Decimal(18, 4)
  unitPrice      Decimal  @db.Decimal(18, 4)
  discountAmount Decimal  @default(0) @db.Decimal(18, 4)
  vatRate        Decimal  @default(15.00) @db.Decimal(5, 2)
  vatAmount      Decimal  @default(0) @db.Decimal(18, 4)
  lineSubtotal   Decimal  @default(0) @db.Decimal(18, 4)
  lineTotal      Decimal  @default(0) @db.Decimal(18, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([companyId, invoiceId])
  @@index([companyId, productId])
  @@index([companyId, warehouseId])
  @@map("sales_invoice_lines")
}

// =====================================================
// Phase 5: Purchases Core — Purchase invoices only.
// NO accounting, NO GL, NO COGS, NO FIFO/LIFO/avg cost,
// NO landed cost, NO supplier balance, NO payments,
// NO purchase returns, NO debit notes, NO credit notes,
// NO ZATCA, NO HR/Payroll, NO SaaS billing.
// =====================================================

enum PurchaseInvoiceStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model PurchaseInvoice {
  id            String                @id @default(cuid())
  companyId     String
  invoiceNumber String
  status        PurchaseInvoiceStatus @default(DRAFT)
  supplierId    String? // must be Partner of type SUPPLIER or BOTH
  purchaseDate  DateTime?
  dueDate       DateTime?
  subtotal      Decimal               @default(0) @db.Decimal(18, 4)
  vatTotal      Decimal               @default(0) @db.Decimal(18, 4)
  discountTotal Decimal               @default(0) @db.Decimal(18, 4)
  total         Decimal               @default(0) @db.Decimal(18, 4)
  notes         String?
  receivedAt    DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  createdById   String?
  updatedById   String?
  receivedById  String?
  cancelledById String?
  deletedAt     DateTime?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier    Partner? @relation("PurchaseInvoiceSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy   User?    @relation("PurchaseInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?    @relation("PurchaseInvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  receivedBy  User?    @relation("PurchaseInvoiceReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  cancelledBy User?    @relation("PurchaseInvoiceCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  lines    PurchaseInvoiceLine[]
  payments Payment[]             @relation("PaymentPurchaseInvoice")

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([companyId, supplierId])
  @@index([companyId, purchaseDate])
  @@index([companyId, deletedAt])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id             String   @id @default(cuid())
  companyId      String
  invoiceId      String
  productId      String
  warehouseId    String? // null for SERVICE lines; required for PRODUCT lines on receive
  description    String?
  quantity       Decimal  @db.Decimal(18, 4)
  unitCost       Decimal  @db.Decimal(18, 4) // server-side authoritative
  discountAmount Decimal  @default(0) @db.Decimal(18, 4)
  vatRate        Decimal  @default(15.00) @db.Decimal(5, 2)
  vatAmount      Decimal  @default(0) @db.Decimal(18, 4)
  lineSubtotal   Decimal  @default(0) @db.Decimal(18, 4)
  lineTotal      Decimal  @default(0) @db.Decimal(18, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([companyId, invoiceId])
  @@index([companyId, productId])
  @@index([companyId, warehouseId])
  @@map("purchase_invoice_lines")
}

// =====================================================
// Phase 6: Accounting Core — Chart of Accounts + Manual
// Journal Entries only.
//
// Backend scope (strict — anything below is FORBIDDEN in Phase 6):
//   * No financial reports (Trial Balance / Balance Sheet / P&L / VAT).
//   * No ZATCA / e-invoicing / QR / CSID / XML.
//   * No automated posting from Sales or Purchases invoices.
//   * No AR / AP ledgers, no customer/supplier statements.
//   * No payments / bank reconciliation / cash management.
//   * No cost accounting / COGS / inventory valuation / fixed assets.
//   * No payroll accounting / HR.
//   * No SaaS billing / payment gateway.
//   * No returns / debit notes / credit notes.
//   * No reverse entries / period locking.
//   * No default / seed / demo chart of accounts.
//
// What IS in Phase 6:
//   * Chart of Accounts (Account: code, name, nameAr, type, normalBalance,
//     parentId optional, isActive, deletedAt).
//   * Manual Journal Entries (DRAFT / POSTED / CANCELLED) + lines.
//   * Double-entry validation (debit == credit, ≥2 lines, no both-debit-credit
//     same line, no zero lines, server-side Decimal only).
//   * RBAC, companyId scoping, append-only audit, no mock data.
// =====================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Account {
  id            String        @id @default(cuid())
  companyId     String
  code          String // unique per company (enforced by index)
  name          String
  nameAr        String?
  type          AccountType
  normalBalance NormalBalance
  parentId      String? // optional parent for hierarchy (same company only)
  isActive      Boolean       @default(true)
  deletedAt     DateTime? // soft delete only
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String?
  updatedById   String?

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      Account?           @relation("AccountParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    Account[]          @relation("AccountParent")
  createdBy   User?              @relation("AccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?              @relation("AccountUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  debitLines  JournalEntryLine[] @relation("JELineDebitAccount")
  creditLines JournalEntryLine[] @relation("JELineCreditAccount")

  // Partial unique index for code-per-company is added via raw SQL in the
  // migration (Prisma cannot express non-deleted uniques directly).
  @@index([companyId, isActive])
  @@index([companyId, deletedAt])
  @@index([companyId, type])
  @@index([companyId, parentId])
  @@index([companyId, code])
  @@map("accounts")
}

model JournalEntry {
  id            String             @id @default(cuid())
  companyId     String
  entryNumber   String // je-YYYYMMDD-NNNN, unique per company
  status        JournalEntryStatus @default(DRAFT)
  entryDate     DateTime           @default(now())
  description   String? // header-level memo / narration
  reference     String? // optional external doc ref (invoice id, etc.)
  totalDebit    Decimal            @default(0) @db.Decimal(18, 4) // server-computed sum of line debits
  totalCredit   Decimal            @default(0) @db.Decimal(18, 4) // server-computed sum of line credits
  notes         String?
  postedAt      DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  createdById   String?
  updatedById   String?
  postedById    String?
  cancelledById String?

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("JournalEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?              @relation("JournalEntryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  postedBy    User?              @relation("JournalEntryPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  cancelledBy User?              @relation("JournalEntryCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  lines       JournalEntryLine[]

  @@unique([companyId, entryNumber])
  @@index([companyId, status])
  @@index([companyId, entryDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id              String   @id @default(cuid())
  companyId       String
  entryId         String
  debitAccountId  String? // exactly one of debitAccountId / creditAccountId must be set per line
  creditAccountId String?
  description     String? // per-line memo
  debit           Decimal  @default(0) @db.Decimal(18, 4) // server-side authoritative
  credit          Decimal  @default(0) @db.Decimal(18, 4) // server-side authoritative
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entry         JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  debitAccount  Account?     @relation("JELineDebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount Account?     @relation("JELineCreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)

  @@index([companyId, entryId])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@map("journal_entry_lines")
}
