# =====================================================
# ERP System — Root environment example
# Copy this file to .env and fill in real values.
# DO NOT commit .env to git.
# =====================================================

# Node environment
NODE_ENV=development

# Backend API
BACKEND_PORT=3001
BACKEND_API_PREFIX=/api

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api
FRONTEND_PORT=3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://erp_user:erp_dev_password_change_me@localhost:5432/erp_dev?schema=public

# JWT secrets (CHANGE for production; min 32 chars)
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_at_least_32_chars_access
JWT_REFRESH_SECRET=replace_me_with_a_long_random_string_at_least_32_chars_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS
CORS_ORIGIN=http://localhost:3000
